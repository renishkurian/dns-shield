# DNS Shield — Environment Configuration
# Copy to .env and fill in for production

SECRET_KEY=change-me-to-a-long-random-secret-key
DEBUG=false
HTTPS=false

# Comma-separated list of allowed hostnames
ALLOWED_HOSTS=localhost,127.0.0.1,raspberrypi.local

# Redis
REDIS_URL=redis://127.0.0.1:6379/0

# DNS Proxy
DNS_PROXY_HOST=0.0.0.0
DNS_PROXY_PORT=53
UPSTREAM_DNS=127.0.0.1
UPSTREAM_DNS_PORT=5335

# Session timeout in seconds (default 8 hours)
SESSION_TIMEOUT=28800
